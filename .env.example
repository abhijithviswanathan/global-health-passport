# Generate real LOCAL values with python3 scripts/configure.py.
# Do not use this synthetic configuration with real patient information.
DEMO_MODE=true
DEMO_PASSWORD=
DATABASE_PASSWORD=
IDENTITY_ENCRYPTION_KEY=
DOCUMENT_ENCRYPTION_KEY=
COOKIE_SECURE=false
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGINS=http://localhost:5173
# Optional actual scanner executable. Empty keeps all uploads quarantined.
CLAMAV_EXECUTABLE=
# Deployment requires separate reviewed secrets, credentials and jurisdiction configuration.
# DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/passport
# DATABASE_USER=passport
# PASSPORT_SIGNING_PRIVATE_KEY=
# PASSPORT_SIGNING_PUBLIC_KEY=

# Local face-presence checking and AES-GCM photo storage (backend working directory).
PHOTO_STORAGE_PATH=./data/photos
PHOTO_CHECK_PYTHON=./photo-check/.venv/bin/python
PHOTO_CHECK_SCRIPT=./photo-check/check.py

# Optional private eligibility gateway; synthetic mode rejects external configuration.
# Leave blank unless an approved server-to-server integration is available.
ELIGIBILITY_GATEWAY_URL=
ELIGIBILITY_GATEWAY_TOKEN=
